{
  "CORSRules": [
    {
      "AllowedOrigins": [
        "*"
      ],
      "AllowedMethods": [
        "PUT",
        "HEAD",
        "GET",
        "POST"
      ],
      "AllowedHeaders": [
        "*",
        "content-type",
        "cache-control",
        "content-disposition",
        "x-amz-checksum-sha256"
      ],
      "ExposeHeaders": [
        "ETag",
        "x-amz-server-side-encryption",
        "x-amz-request-id",
        "x-amz-id-2"
      ],
      "MaxAgeSeconds": 3600
    }
  ]
}
