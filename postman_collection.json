{
  "info": {
    "name": "Cloudinary Clone - API",
    "description": "Standardized English Postman collection. Fill in the variables under the Collection Variables tab (or in an Environment) before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://cloudinary-aws-backend.vercel.app", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "fileName", "value": "", "type": "string" },
    { "key": "extension", "value": "", "type": "string" },
    { "key": "fileType", "value": "", "type": "string" },
    { "key": "fileSize", "value": "", "type": "string" },
    { "key": "visibility", "value": "", "type": "string" },
    { "key": "sha256Hash", "value": "", "type": "string" },
    { "key": "ticketId", "value": "", "type": "string" },
    { "key": "uploadUrl", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Request Upload Ticket (Presigned URL)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.ticketId) pm.collectionVariables.set('ticketId', json.ticketId);",
              "if (json.uploadUrl) pm.collectionVariables.set('uploadUrl', json.uploadUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"orgId\": \"{{orgId}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": \"{{fileSize}}\",\n  \"visibility\": \"{{visibility}}\",\n  \"sha256Hash\": \"{{sha256Hash}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload"]
        },
        "description": "Validates user/tenant/permissions and returns ticketId + S3 Presigned uploadUrl. Saves both automatically into collection variables."
      }
    },
    {
      "name": "2. Direct Upload to S3 Presigned URL",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "{{fileType}}" }],
        "body": { "mode": "file", "file": {} },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": ["{{uploadUrl}}"]
        },
        "description": "Select the binary file in Body -> binary. The Content-Type header must match the fileType sent in Step 1."
      }
    },
    {
      "name": "3. Confirm Upload (Persist in Database)",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/upload?ticketId={{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload"],
          "query": [{ "key": "ticketId", "value": "{{ticketId}}" }]
        },
        "description": "Notifies backend that upload completed to mark file as 'completed' and record audit log."
      }
    },
    {
      "name": "4. Get Service Logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"]
        },
        "description": "Retrieves recent audit logs from Supabase (service_logs table)."
      }
    },
    {
      "name": "5. Get File Records",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": ["{{baseUrl}}"],
          "path": ["api", "records"]
        },
        "description": "Retrieves recent file records from Supabase (files table with user & organization join)."
      }
    },
    {
      "name": "6. Test Environment Cleanup",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/test/cleanup?userId={{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "test", "cleanup"],
          "query": [
            { "key": "userId", "value": "{{userId}}" },
            { "key": "all", "value": "true", "description": "true to purge all test files under pending/", "disabled": true }
          ]
        },
        "description": "Purges S3 test objects under pending/ and cleans test rows from Supabase (5GB Free Tier Protection)."
      }
    }
  ]
}
