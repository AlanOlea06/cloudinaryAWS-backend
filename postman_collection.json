{
  "info": {
    "name": "Cloudinary Clone - API (Hardened Dual Key Model & Direct S3)",
    "description": "Colección Postman actualizada para el modelo de doble autenticación (Root Key + Delegated Scoped Keys), cupo atómico con bloqueo de fila en BD, subida directa a AWS S3 y entrega privada sin intermediación de Vercel.\n\nVariables secretas:\n- adminSecret: ADMIN_API_SECRET para rutas de administración global de plataforma.\n- apiKey: API Key Maestra de organización (sk_live_...) con can_manage_keys=true.\n- secondaryApiKey: API Key secundaria/delegada (can_manage_keys=false).\n- cronSecret: CRON_SECRET para /api/cron/maintenance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cloudinary-aws-backend.vercel.app",
      "type": "string"
    },
    {
      "key": "adminSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "cronSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "secret"
    },
    {
      "key": "keyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "secondaryApiKey",
      "value": "",
      "type": "secret"
    },
    {
      "key": "secondaryKeyId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "a1111111-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "otherOrgUserId",
      "value": "b2222222-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "imagen de prueba 1.jpg",
      "type": "string"
    },
    {
      "key": "extension",
      "value": ".jpg",
      "type": "string"
    },
    {
      "key": "fileType",
      "value": "image/jpeg",
      "type": "string"
    },
    {
      "key": "fileSize",
      "value": "1024",
      "type": "string"
    },
    {
      "key": "visibility",
      "value": "private",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "confirmToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "uploadUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "downloadUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0.0 Healthcheck Público (GET /api/health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Única ruta pública bajo /api/*. Devuelve 200 OK con estado del servicio sin exponer secretos."
      }
    },
    {
      "name": "0.1A Crear API Key Maestra de Organización (POST /api/keys con x-admin-secret)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.apiKey) {",
              "    pm.collectionVariables.set('apiKey', json.apiKey);",
              "}",
              "if (json.keyMetadata && json.keyMetadata.id) {",
              "    pm.collectionVariables.set('keyId', json.keyMetadata.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orgId\": \"{{orgId}}\",\n  \"userId\": null,\n  \"name\": \"Llave Maestra Organización 1\",\n  \"canRead\": true,\n  \"canUpload\": true,\n  \"canDelete\": true,\n  \"canManageKeys\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Crea la API Key Raíz/Maestra de la organización con canManageKeys=true usando x-admin-secret."
      }
    },
    {
      "name": "0.1B Delegación: Crear API Key Secundaria (POST /api/keys con x-api-key maestra)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.apiKey) {",
              "    pm.collectionVariables.set('secondaryApiKey', json.apiKey);",
              "}",
              "if (json.keyMetadata && json.keyMetadata.id) {",
              "    pm.collectionVariables.set('secondaryKeyId', json.keyMetadata.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "description": "Llave maestra con can_manage_keys=true"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Llave Secundaria de Subida\",\n  \"canRead\": true,\n  \"canUpload\": true,\n  \"canDelete\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Crea una llave delegada subordinada para su propia organización sin intervención del administrador. La llave se crea forzosamente con can_manage_keys=false."
      }
    },
    {
      "name": "0.1C [Seguridad] Intento de Escalada de Privilegios (403 PRIVILEGE_ESCALATION_BLOCKED)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{secondaryApiKey}}",
            "description": "Llave secundaria que intenta crear otra llave o escalar permisos"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Intento Escalada\",\n  \"canRead\": true,\n  \"canUpload\": true,\n  \"canDelete\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Verifica que el servidor rechace con 403 Forbidden y registre PRIVILEGE_ESCALATION_BLOCKED en service_logs si se intentan crear permisos superiores a los propios."
      }
    },
    {
      "name": "0.1D Promover o Modificar Llave Existente (PATCH /api/keys con x-admin-secret)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{keyId}}\",\n  \"canManageKeys\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Permite al administrador de la plataforma promover una llave de organización existente a llave maestra (can_manage_keys=true)."
      }
    },
    {
      "name": "0.2A Listar API Keys como Administrador (GET /api/keys con x-admin-secret)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys?org_id={{orgId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ],
          "query": [
            {
              "key": "org_id",
              "value": "{{orgId}}"
            }
          ]
        },
        "description": "Lista las llaves de cualquier organización sin exponer claves en texto claro ni hashes completos."
      }
    },
    {
      "name": "0.2B Listar API Keys como Organización (GET /api/keys con x-api-key)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Lista exclusivamente las llaves pertenecientes a la propia organización con aislamiento multi-inquilino estricto."
      }
    },
    {
      "name": "0.3A [Seguridad] Auto-eliminación Bloqueada (DELETE /api/keys -> 403 CANNOT_DELETE_SELF)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys?id={{keyId}}&mode=revoke",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{keyId}}"
            },
            {
              "key": "mode",
              "value": "revoke"
            }
          ]
        },
        "description": "Verifica que una llave no pueda revocarse ni eliminarse a sí misma (403 CANNOT_DELETE_SELF)."
      }
    },
    {
      "name": "0.3B Revocar o Eliminar Llave Secundaria (DELETE /api/keys con x-api-key)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys?id={{secondaryKeyId}}&mode=revoke",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{secondaryKeyId}}"
            },
            {
              "key": "mode",
              "value": "revoke"
            }
          ]
        },
        "description": "Revoca una llave subordinada de la organización usando la llave maestra."
      }
    },
    {
      "name": "1. Solicitar Ticket de Subida (POST /api/upload)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const t = json.ticket || json;",
              "if (t.ticketId) pm.collectionVariables.set('ticketId', t.ticketId);",
              "if (t.fileId) pm.collectionVariables.set('fileId', t.fileId);",
              "if (t.confirmToken) pm.collectionVariables.set('confirmToken', t.confirmToken);",
              "if (t.uploadUrl) pm.collectionVariables.set('uploadUrl', t.uploadUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "description": "API Key de la organización (backend)"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}",
            "description": "UUID del usuario final validado contra la organización de la llave"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"{{visibility}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Genera ticket prefirmado de S3 directo hacia static/files/<rand128>.<ext>. Cero bytes por Vercel."
      }
    },
    {
      "name": "1.1 [Seguridad] Rechazo por usuario de otra organización (403 FORBIDDEN_USER_ORG_MISMATCH)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{otherOrgUserId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"private\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Verifica que el middleware bloquee con 403 FORBIDDEN_USER_ORG_MISMATCH cuando x-user-id pertenece a otra organización."
      }
    },
    {
      "name": "1.2 [Seguridad] Rechazo por omitir x-user-id en llave de organización (400 MISSING_END_USER_ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"orgId\": \"{{orgId}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"private\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Demuestra que enviar userId/orgId en el body es ignorado y que una llave sin user_id fijo exige la cabecera x-user-id (400 MISSING_END_USER_ID)."
      }
    },
    {
      "name": "2. Subida Directa Binaria a S3 (PUT uploadUrl)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{fileType}}"
          },
          {
            "key": "Cache-Control",
            "value": "private, no-store, no-cache, max-age=0, must-revalidate"
          }
        ],
        "body": {
          "mode": "file",
          "file": {}
        },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": [
            "{{uploadUrl}}"
          ]
        },
        "description": "Sube el binario directamente desde el cliente hacia AWS S3 sin pasar por el servidor."
      }
    },
    {
      "name": "3. Confirmar Subida (PUT /api/upload)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/upload?ticketId={{ticketId}}&token={{confirmToken}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ],
          "query": [
            {
              "key": "ticketId",
              "value": "{{ticketId}}"
            },
            {
              "key": "token",
              "value": "{{confirmToken}}"
            }
          ]
        },
        "description": "Valida existencia del objeto en S3, lee los primeros 32 bytes (Range GET) para verificar el magic number real, valida checksum SHA-256 de S3 y marca el estado como 'uploaded'."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Estado HTTP es 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Archivo confirmado con fileStatus = uploaded', function () {",
              "    pm.expect(json.fileStatus).to.eql('uploaded');",
              "    pm.expect(json.status).to.eql('success');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "3.1 Obtener URL de Entrega (GET /api/files/:id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.url) {",
              "    pm.collectionVariables.set('downloadUrl', json.url);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{fileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "{{fileId}}"
          ]
        },
        "description": "Para archivos privados devuelve URL prefirmada de S3 (5 minutos, no-store) validando que el usuario sea el dueño. Para públicos devuelve URL de CloudFront."
      }
    },
    {
      "name": "3.2 Descargar Archivo (GET downloadUrl)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{downloadUrl}}",
          "host": [
            "{{downloadUrl}}"
          ]
        },
        "description": "Descarga directa de los bytes desde S3 o CloudFront hacia el cliente."
      }
    },
    {
      "name": "4. Consultar Logs de Auditoría (GET /api/logs)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ]
        },
        "description": "Consulta la bitácora service_logs. Exige x-admin-secret."
      }
    },
    {
      "name": "5. Consultar Registros de Archivos (GET /api/records)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records"
          ]
        },
        "description": "Consulta registros administrativos en public.files. Exige x-admin-secret."
      }
    },
    {
      "name": "6. Consultar Organizaciones y Usuarios (GET /api/users)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Lista organizaciones y usuarios registrados. Exige x-admin-secret."
      }
    },
    {
      "name": "7. Ejecutar Cron de Mantenimiento (GET /api/cron/maintenance)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cronSecret}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cron/maintenance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cron",
            "maintenance"
          ]
        },
        "description": "Ejecuta limpieza de tickets expirados y mantenimiento. Exige Authorization: Bearer <CRON_SECRET>."
      }
    }
  ]
}