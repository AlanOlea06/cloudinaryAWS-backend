{
  "info": {
    "name": "Cloudinary Clone - API",
    "description": "Colección con variables libres. Rellena los valores en la pestaña Variables de la colección (o en un Environment) antes de ejecutar cada request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://cloudinary-aws-backend.vercel.app", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "orgId", "value": "", "type": "string" },
    { "key": "fileName", "value": "", "type": "string" },
    { "key": "fileType", "value": "", "type": "string" },
    { "key": "fileSize", "value": "", "type": "string" },
    { "key": "visibilidad", "value": "", "type": "string" },
    { "key": "hashSha256", "value": "", "type": "string" },
    { "key": "ticketId", "value": "", "type": "string" },
    { "key": "uploadUrl", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Solicitar Ticket (Presigned URL)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.ticketId) pm.collectionVariables.set('ticketId', json.ticketId);",
              "if (json.uploadUrl) pm.collectionVariables.set('uploadUrl', json.uploadUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"orgId\": \"{{orgId}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": \"{{fileSize}}\",\n  \"visibilidad\": \"{{visibilidad}}\",\n  \"hashSha256\": \"{{hashSha256}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload"]
        },
        "description": "Valida usuario/organización/permisos y devuelve ticketId + uploadUrl. Guarda ambos automáticamente en las variables de la colección."
      }
    },
    {
      "name": "2. Subir Archivo a la URL Pre-firmada",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "{{fileType}}" }],
        "body": { "mode": "file", "file": {} },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": ["{{uploadUrl}}"]
        },
        "description": "Selecciona el archivo en Body -> binary. El Content-Type debe ser el mismo fileType usado al pedir el ticket."
      }
    },
    {
      "name": "3. Confirmar Subida",
      "request": {
        "method": "PUT",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/upload?ticketId={{ticketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "upload"],
          "query": [{ "key": "ticketId", "value": "{{ticketId}}" }]
        },
        "description": "Marca el archivo como completado en Supabase y registra el log."
      }
    },
    {
      "name": "4. Consultar Logs",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": ["{{baseUrl}}"],
          "path": ["api", "logs"]
        }
      }
    },
    {
      "name": "5. Consultar Archivos",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": ["{{baseUrl}}"],
          "path": ["api", "records"]
        }
      }
    },
    {
      "name": "6. Limpieza de Pruebas",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/test/cleanup?userId={{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "test", "cleanup"],
          "query": [
            { "key": "userId", "value": "{{userId}}" },
            { "key": "all", "value": "", "description": "true para limpiar todo pendientes/", "disabled": true }
          ]
        }
      }
    }
  ]
}
