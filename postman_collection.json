{
  "info": {
    "name": "Cloudinary Clone - API (Hardened Sections 2 & 3)",
    "description": "Colección Postman actualizada para las Secciones 2 (Cierre de acceso abierto) y 3 (Modelo de llaves por organización - Opción A).\n\nVariables secretas (tipo 'secret'):\n- adminSecret: ADMIN_API_SECRET para rutas administrativas (/api/keys, /api/logs, /api/records, /api/users).\n- cronSecret: CRON_SECRET para /api/cron/maintenance.\n- apiKey: API Key de organización (sk_live_...) para uso exclusivo en backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://cloudinary-aws-backend.vercel.app",
      "type": "string"
    },
    {
      "key": "adminSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "cronSecret",
      "value": "",
      "type": "secret"
    },
    {
      "key": "apiKey",
      "value": "",
      "type": "secret"
    },
    {
      "key": "keyId",
      "value": "f987452a-8a73-4c0e-b955-24c203e3070f",
      "type": "string"
    },
    {
      "key": "orgId",
      "value": "11111111-1111-1111-1111-111111111111",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "a1111111-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "otherOrgUserId",
      "value": "b2222222-0000-0000-0000-000000000001",
      "type": "string"
    },
    {
      "key": "fileName",
      "value": "imagen de prueba 1.jpg",
      "type": "string"
    },
    {
      "key": "extension",
      "value": ".jpg",
      "type": "string"
    },
    {
      "key": "fileType",
      "value": "image/jpeg",
      "type": "string"
    },
    {
      "key": "fileSize",
      "value": "1024",
      "type": "string"
    },
    {
      "key": "visibility",
      "value": "private",
      "type": "string"
    },
    {
      "key": "ticketId",
      "value": "",
      "type": "string"
    },
    {
      "key": "fileId",
      "value": "",
      "type": "string"
    },
    {
      "key": "confirmToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "uploadUrl",
      "value": "",
      "type": "string"
    },
    {
      "key": "downloadUrl",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0.0 Healthcheck Público (GET /api/health)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        },
        "description": "Única ruta pública bajo /api/*. Devuelve 200 OK sin exponer nombre del bucket ni datos sensibles."
      }
    },
    {
      "name": "0.1 Crear API Key de Organización (POST /api/keys)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.apiKey) {",
              "    pm.collectionVariables.set('apiKey', json.apiKey);",
              "}",
              "if (json.keyMetadata && json.keyMetadata.id) {",
              "    pm.collectionVariables.set('keyId', json.keyMetadata.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"org_id\": \"{{orgId}}\",\n  \"user_id\": null,\n  \"name\": \"Backend Organization Key\",\n  \"can_read\": true,\n  \"can_upload\": true,\n  \"can_delete\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/keys",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ]
        },
        "description": "Crea una API Key de organización (user_id: null) para uso en el backend del cliente. Exige x-admin-secret."
      }
    },
    {
      "name": "0.2 Listar API Keys de Organización (GET /api/keys)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys?org_id={{orgId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ],
          "query": [
            {
              "key": "org_id",
              "value": "{{orgId}}"
            }
          ]
        },
        "description": "Lista las API Keys de la organización sin exponer hashes ni secretos. Exige x-admin-secret."
      }
    },
    {
      "name": "0.3 Eliminar o Revocar API Key (DELETE /api/keys)",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/keys?id={{keyId}}&mode=delete",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "keys"
          ],
          "query": [
            {
              "key": "id",
              "value": "{{keyId}}"
            },
            {
              "key": "mode",
              "value": "delete"
            }
          ]
        },
        "description": "Elimina o revoca una API Key por ID. Exige x-admin-secret."
      }
    },
    {
      "name": "1. Solicitar Ticket de Subida (POST /api/upload)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "const t = json.ticket || json;",
              "if (t.ticketId) pm.collectionVariables.set('ticketId', t.ticketId);",
              "if (t.fileId) pm.collectionVariables.set('fileId', t.fileId);",
              "if (t.confirmToken) pm.collectionVariables.set('confirmToken', t.confirmToken);",
              "if (t.uploadUrl) pm.collectionVariables.set('uploadUrl', t.uploadUrl);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "description": "API Key de la organización (backend)"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}",
            "description": "UUID del usuario final validado contra la organización de la llave"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"{{visibility}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Sección 3: Toma orgId y userId exclusivamente del contexto validado (x-api-key + x-user-id) e ignora userId/orgId del body."
      }
    },
    {
      "name": "1.1 [Seguridad] Rechazo por usuario de otra organización (403 FORBIDDEN_USER_ORG_MISMATCH)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{otherOrgUserId}}",
            "description": "Usuario de Organización 2 usando llave de Organización 1"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"private\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Verifica que el middleware bloquee con 403 FORBIDDEN_USER_ORG_MISMATCH cuando x-user-id pertenece a otra organización."
      }
    },
    {
      "name": "1.2 [Seguridad] Rechazo por omitir x-user-id en llave de organización (400 MISSING_END_USER_ID)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"orgId\": \"{{orgId}}\",\n  \"fileName\": \"{{fileName}}\",\n  \"extension\": \"{{extension}}\",\n  \"fileType\": \"{{fileType}}\",\n  \"fileSize\": {{fileSize}},\n  \"visibility\": \"private\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/upload",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ]
        },
        "description": "Demuestra que enviar userId/orgId en el body es ignorado y que una llave sin user_id fijo exige la cabecera x-user-id (400 MISSING_END_USER_ID)."
      }
    },
    {
      "name": "2. Subida Directa Binaria a S3 (PUT uploadUrl)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "{{fileType}}"
          },
          {
            "key": "Cache-Control",
            "value": "private, no-store, no-cache, max-age=0, must-revalidate"
          }
        ],
        "body": {
          "mode": "file",
          "file": {}
        },
        "url": {
          "raw": "{{uploadUrl}}",
          "host": [
            "{{uploadUrl}}"
          ]
        },
        "description": "Sube el binario directamente a S3 con las cabeceras firmadas en X-Amz-SignedHeaders."
      }
    },
    {
      "name": "3. Confirmar Subida y Procesar (PUT /api/upload)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/upload?ticketId={{ticketId}}&token={{confirmToken}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "upload"
          ],
          "query": [
            {
              "key": "ticketId",
              "value": "{{ticketId}}"
            },
            {
              "key": "token",
              "value": "{{confirmToken}}"
            }
          ]
        },
        "description": "Verifica firma HMAC del ticket, comprueba objeto en S3 (HeadObject) y procesa el archivo hacia static/files/."
      }
    },
    {
      "name": "3.1. Obtener URL de Entrega (GET /api/files/:id)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const json = pm.response.json();",
              "if (json.url) {",
              "    pm.collectionVariables.set('downloadUrl', json.url);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{fileId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "{{fileId}}"
          ]
        },
        "description": "Para archivos privados valida que x-user-id sea el propietario y devuelve URL prefirmada de S3 (5 min). Para públicos devuelve URL de CloudFront."
      }
    },
    {
      "name": "3.2. Descargar Archivo (GET downloadUrl)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{downloadUrl}}",
          "host": [
            "{{downloadUrl}}"
          ]
        },
        "description": "Descarga el archivo directamente desde S3 (privado) o CloudFront (público)."
      }
    },
    {
      "name": "3.3. Descargar Archivo Privado por Proxy Seguro (GET /api/files/:id/content)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}"
          },
          {
            "key": "x-user-id",
            "value": "{{userId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/files/{{fileId}}/content",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "files",
            "{{fileId}}",
            "content"
          ]
        },
        "description": "Descarga archivos privados directamente vía proxy seguro (hasta 4 MB) sin exponer claves internas de S3 al cliente."
      }
    },
    {
      "name": "4. Consultar Logs de Auditoría (GET /api/logs)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/logs",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "logs"
          ]
        },
        "description": "Consulta la bitácora service_logs. Exige x-admin-secret."
      }
    },
    {
      "name": "5. Consultar Registros de Archivos (GET /api/records)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/records",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "records"
          ]
        },
        "description": "Consulta registros administrativos en public.files. Exige x-admin-secret."
      }
    },
    {
      "name": "6. Consultar Organizaciones y Usuarios (GET /api/users)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-admin-secret",
            "value": "{{adminSecret}}",
            "description": "Obligatorio (ADMIN_API_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Lista organizaciones y usuarios registrados. Exige x-admin-secret."
      }
    },
    {
      "name": "7. Ejecutar Cron de Mantenimiento (GET /api/cron/maintenance)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{cronSecret}}",
            "description": "Obligatorio (Bearer CRON_SECRET)"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/cron/maintenance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cron",
            "maintenance"
          ]
        },
        "description": "Ejecuta limpieza de tickets vencidos, aborto de multiparts abandonados y reintentos. Exige Authorization: Bearer <CRON_SECRET>."
      }
    }
  ]
}